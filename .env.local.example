# Supabase
# ローカル開発時（`pnpm supabase:start` 実行後）は以下のコマンドで
# ローカル用の URL・キーを確認できます: `pnpm supabase:status`
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用。RLSをバイパスするため、絶対に NEXT_PUBLIC_ を付けずクライアントに露出させないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 管理者招待メールのリンク先(auth/callback)の組み立てに使用。未設定時は lib/constants.ts のデフォルト値が使われる
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# プレビュー環境での自動ログイン（本番環境では設定しない）
NEXT_PUBLIC_IS_PREVIEW=true
PREVIEW_AUTO_LOGIN_EMAIL=test@example.com
PREVIEW_AUTO_LOGIN_PASSWORD=your-test-password

# メール送信（Resend）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=やきゅスコ <noreply@yourdomain.com>

# チーム問い合わせフォーム（Cloudflare Turnstile）
# ローカル動作確認には常に成功するCloudflare公式のテスト用キーが使える
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# チーム問い合わせフォームのレート制限用。IPアドレスをハッシュ化する際のソルト（任意の文字列でよい）
CONTACT_IP_HASH_SALT=change-me-in-production

# AI試合寸評生成（未設定の場合は機能自体が無効化される）
# 現状はGeminiの無料枠を利用する想定（送信内容がモデル改善の学習対象になる点に留意）
# AI_MODELはGoogleが常に現行の軽量flashモデルを指すよう更新するエイリアスを既定にしている
# （個別モデルIDは提供終了が早く、実際に応答したモデルバージョンは生成のたびにDBのai_review_modelへ記録される）
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-flash-lite-latest
