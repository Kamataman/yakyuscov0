# Supabase
# ローカル開発時（`pnpm supabase:start` 実行後）は以下のコマンドで
# ローカル用の URL・キーを確認できます: `pnpm supabase:status`
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用。RLSをバイパスするため、絶対に NEXT_PUBLIC_ を付けずクライアントに露出させないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 管理者招待メールのリンク先(auth/callback)の組み立てに使用。未設定時は lib/constants.ts のデフォルト値が使われる
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# プレビュー環境での自動ログイン（本番環境では設定しない）
NEXT_PUBLIC_IS_PREVIEW=true
PREVIEW_AUTO_LOGIN_EMAIL=test@example.com
PREVIEW_AUTO_LOGIN_PASSWORD=your-test-password

# メール送信（Resend）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=やきゅスコ <noreply@yourdomain.com>
